  m_text: "\u0422\u0432\u043E\u044F \u0437\u0430\u0434\u0430\u0447\u0430 - \u0434\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0442\u044C
    \u043F\u043E\u0441\u044B\u043B\u043A\u0438. \u0412 \u0433\u043E\u0440\u043E\u0434\u0435
    \u0435\u0441\u0442\u044C \u0440\u0430\u0437\u043D\u044B\u0435 \u0440\u0430\u0439\u043E\u043D\u044B.
    \u0427\u0435\u043C \u043B\u0443\u0447\u0448\u0435 \u0442\u0432\u043E\u0439 \u0440\u0435\u0439\u0442\u0438\u043D\u0433,
    \u0442\u0435\u043C \u043B\u0443\u0447\u0448\u0435 \u0440\u0430\u0439\u043E\u043D\u044B
    \u043F\u043E\u043F\u0430\u0434\u0430\u044E\u0442\u0441\u044F \u0432 \u0434\u043E\u0441\u0442\u0430\u0432\u043A\u0435,
    \u0430 \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043D\u043D\u043E,
    \u043B\u0443\u0447\u0448\u0435 \u0431\u0443\u0434\u0443\u0442 \u043F\u043B\u0430\u0442\u0438\u0442\u044C.
    \u0421\u0442\u0430\u0440\u0430\u0439\u0441\u044F \u043F\u043E\u0432\u044B\u0448\u0430\u0442\u044C
    \u0441\u0432\u043E\u0439 \u0440\u0435\u0439\u0442\u0438\u043D\u0433, \u0434\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044F
    \u043F\u043E\u0441\u044B\u043B\u043A\u0438 \u0432 \u0446\u0435\u043B\u043E\u0441\u0442\u0438
    \u0438 \u0441\u043E\u0445\u0440\u0430\u043D\u043D\u043E\u0441\u0442\u0438."
